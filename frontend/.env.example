# QuantPulse AI — frontend env (copy to .env.local, never commit)
# Backend base URL. Local dev = your laptop. On Vercel, set this same value
# as an env var in the dashboard (http://localhost:8000 works for you on
# your own machine; use a tunnel URL if others need access).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set to 1 to require a session for /dashboard and the other app routes.
# 0 (default) keeps the terminal usable with zero keys — demo mode.
NEXT_PUBLIC_REQUIRE_AUTH=0
