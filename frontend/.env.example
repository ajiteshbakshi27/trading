# Parakh — frontend env (copy to .env.local, never commit)
# Backend base URL (Render URL in production).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth. Leave blank for local dev mode (no sign-in needed).
# Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
