# Parakh backend — copy to .env and fill what you have.
# Everything is optional for local dev: missing keys fall back to honest,
# clearly-labelled simulated data and a local dev user.

# --- App ---
ENVIRONMENT=development            # set to "production" on Render
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_EMAILS=                      # comma-separated; operator-only endpoints (Labs broker orders)
CRON_SECRET=                       # random string; scheduled jobs send it as X-Cron-Secret

# --- Auth + database (Supabase) ---
# Dashboard → Project Settings → API (URL) and → Database (connection string).
SUPABASE_URL=
SUPABASE_JWT_SECRET=               # only if your project still uses the legacy JWT secret
DATABASE_URL=                      # postgresql://... (blank = local SQLite file parakh.db)

# --- Shared state (rate limits, kill switch, caches) ---
REDIS_URL=                         # redis://... (blank = in-memory, single process)

# --- Claude (copilot, idea parsing, autopsy narratives) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Zerodha Kite Connect (trade sync) ---
# developers.kite.trade → create app → redirect URL = <PUBLIC_APP_URL>/broker/zerodha
KITE_API_KEY=
KITE_API_SECRET=
TOKEN_ENCRYPTION_KEY=              # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Hype radar (Reddit) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Telegram alerts ---
TELEGRAM_BOT_TOKEN=                # from @BotFather

# --- Labs only (US experiments) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
FINANCIAL_DATA_API_KEY=
