# QuantPulse AI - copy to .env and fill. Empty/missing = mock fallback.
# --- Market data ---
# Generic provider key (Alpha Vantage / Financial Modeling Prep / Polygon.io)
FINANCIAL_DATA_API_KEY=
FINANCIAL_DATA_PROVIDER=alphavantage
# Indian stocks (NSE/BSE): native Yahoo Finance provider works out of the box.
# Set this ONLY if you run the 0xramm/Indian-Stock-Market-API server
# (optional preferred source when reachable).
# INDIAN_STOCK_API_URL=http://localhost:5000
# Alpaca (paper trading + live prices). ALPACAS_* supported as deprecated fallback.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex

# --- Social sentiment ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=QuantPulse AI Sentiment Bot v1.0
TWITTER_BEARER_TOKEN=

# --- Prediction markets (Polymarket public feed needs no key) ---
KALSHI_API_KEY=

# --- Alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- AI Copilot (optional external LLM; built-in engine works without) ---
COPILOT_LLM_URL=
COPILOT_LLM_KEY=

# --- Supabase / Postgres ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
DATABASE_URL=

# --- Cache / queue ---
REDIS_URL=redis://localhost:6379/0

# --- Frontend origin(s) for CORS (comma-separated) ---
# Local dev ports plus your Vercel app (replace <your-app> after first deploy).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://<your-app>.vercel.app
